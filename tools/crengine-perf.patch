diff --git a/crengine/tests/stylecachetest.cpp b/crengine/tests/stylecachetest.cpp
new file mode 100644
index 0000000..131cfd6
--- /dev/null
+++ b/crengine/tests/stylecachetest.cpp
@@ -0,0 +1,57 @@
+#include "lvstyles.h"
+#include <cstdio>
+
+int main()
+{
+    const struct {
+        css_writing_mode_t writing_mode;
+        css_text_orientation_t text_orientation;
+        css_text_combine_upright_t text_combine_upright;
+        css_text_emphasis_style_t text_emphasis_style;
+    } cases[] = {
+        {css_wm_inherit, css_to_mixed, css_tcu_none, css_tes_inherit},
+        {css_wm_horizontal_tb, css_to_mixed, css_tcu_none, css_tes_none},
+        {css_wm_vertical_rl, css_to_mixed, css_tcu_none, css_tes_inherit},
+        {css_wm_vertical_lr, css_to_upright, css_tcu_all, css_tes_filled_sesame},
+        {css_wm_vertical_rl, css_to_sideways, css_tcu_digits_2, css_tes_open_tri},
+        {css_wm_vertical_lr, css_to_upright, css_tcu_digits_4, css_tes_none},
+    };
+    bool failed = false;
+    for (const auto &test : cases) {
+        css_style_rec_t style;
+        style.writing_mode = test.writing_mode;
+        style.text_orientation = test.text_orientation;
+        style.text_combine_upright = test.text_combine_upright;
+        style.text_emphasis_style = test.text_emphasis_style;
+        SerialBuf encoded(512);
+        if (!style.serialize(encoded)) {
+            std::fprintf(stderr, "Could not serialize test style\n");
+            return 1;
+        }
+        SerialBuf decoded(encoded.buf(), encoded.pos());
+        css_style_rec_t restored;
+        if (!restored.deserialize(decoded) || !(style == restored)
+                || decoded.pos() != encoded.pos()) {
+            std::fprintf(stderr,
+                    "Style cache round-trip failed: writing-mode=%d orientation=%d combine=%d emphasis=%d\n",
+                    test.writing_mode, test.text_orientation,
+                    test.text_combine_upright, test.text_emphasis_style);
+            failed = true;
+        }
+    }
+
+    css_style_rec_t style;
+    SerialBuf encoded(512);
+    if (!style.serialize(encoded)) {
+        std::fprintf(stderr, "Could not serialize corruption test style\n");
+        return 1;
+    }
+    encoded.buf()[encoded.pos() - 1] ^= 1;
+    SerialBuf decoded(encoded.buf(), encoded.pos());
+    css_style_rec_t restored;
+    if (restored.deserialize(decoded)) {
+        std::fprintf(stderr, "Corrupted cached style hash was accepted\n");
+        return 1;
+    }
+    return failed ? 1 : 0;
+}
